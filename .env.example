# CareRelay Environment Configuration (All defaults are 100% FREE for local dev)

# Secret key for JWT Signing (HMAC-SHA256, >= 256 bits)
JWT_SECRET=CareRelaySuperSecretKeyForDevelopmentPurposesMustBeAtLeast256BitsLong!

# Database Configuration (Docker local Postgres)
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# Apache Kafka Broker
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional: Claude / AI API Key (Set to dummy/empty to use the built-in free Mock Clinical Summarizer)
CLAUDE_API_KEY=
